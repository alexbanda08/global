# === Heavy data (1.9 GB+) ===
/data/
/strategy_lab/data/
/strategy_lab/results/
/strategy_lab/features/
/strategy_lab/kronos_ft/
/strategy_lab/logs/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# === Vendored external repos (have their own .git) ===
/external/

# === Generated artifacts (large, regenerable) ===
*.parquet
*.zip
*.pkl
*.h5

# === Editor / OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# === Secrets / local config (defence in depth) ===
# Allow tracking only .env.example (the no-secrets template)
.env
.env.*
!.env.example
.envrc
*.env
secrets.*
credentials.*
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*
config.local.*
*_secret.*
*_secrets.*
local.settings.json
.aws/
.gcp/
.kube/config

# === Allow specific large reports to be tracked (already version-controlled artifacts) ===
!*.pdf

# === Allow text reports / digests ===
!cf.txt
!sr.txt
!v24.txt
!all_coins.txt
!digest.txt
!digest.json

# Local log files
/logs/

# === Raw shadow / migration data dumps (regenerable from VPS, large) ===
/migration_ireland_shadow_*/
/shadow_logs/
/shadow_logs_l25/
/data/v4/refresh_*/
/data/v4/canonical/orderbook_l25/
/data/v4/canonical/trades_polymarket/
/data/v4/canonical/*.parquet
