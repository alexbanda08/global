# Environment variables required by data-pull and refresh scripts.
# Copy this to `.env` (gitignored) and fill in the actual values.
# Source it before running scripts: `set -a && source .env && set +a`

# ── VPS2 (orderbook + trades collector) ──
VPS2_HOST='root@[2605:a140:2323:6975::1]'
VPS2_RO_PWD=''                              # tradingvenue_ro Postgres password
VPS2_SSH_KEY="$HOME/.ssh/vps2_ed25519"      # default — override if elsewhere

# ── VPS3 (TV engine + sleeve resolutions) ──
VPS3_HOST='root@185.190.143.7'
VPS3_TV_PWD=''                              # tradingvenue (write user) Postgres password
VPS3_RO_PWD=''                              # tradingvenue_ro Postgres password (optional)
VPS3_SSH_KEY="$HOME/.ssh/vps3_ed25519"      # default — override if elsewhere

# Source from /etc/tv/tv-ro.env on either VPS to populate these:
#   ssh ... "grep TV_RO_PWD_PLAIN /etc/tv/tv-ro.env"
